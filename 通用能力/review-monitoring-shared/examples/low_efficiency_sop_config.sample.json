        {"node_type": "process_analysis", "node_order": 40, "enabled": true},
        {"node_type": "report_publish", "node_order": 50, "enabled": true},
        {"node_type": "audit_finalize", "node_order": 90, "enabled": true}
      ],
      "metrics": [
        {
          "metric_id": "metric_low_label_rate_reason",
          "metric_name": "reason 粒度低打标率",
          "metric_role": "primary",
          "canonical_metric": "labeling_rate",
          "data_source_id": "aeolus_3888816_review_detail",
          "period_policy": "last_7_complete_days",
          "enabled": true
        }
      ],
      "levels": [
        {
          "sop_id": "low_efficiency_labeling",
          "sop_level_id": "low_efficiency_p0",
          "level_label": "P0",
          "normalized_severity": "critical",
          "priority_order": 1,
          "sla_minutes": 0,
          "sla_text": "立即响应",
          "requires_human_confirm": true,
          "default_audience_policy": "治理负责人+CQC负责人",
          "enabled": true
        },
        {
          "sop_id": "low_efficiency_labeling",
          "sop_level_id": "low_efficiency_p1",
          "level_label": "P1",
          "normalized_severity": "high",
          "priority_order": 2,
          "sla_minutes": 120,
          "sla_text": "2小时内响应",
          "requires_human_confirm": true,
          "default_audience_policy": "治理 BP+1、人审运营负责人",
          "enabled": true
        },
        {
          "sop_id": "low_efficiency_labeling",
          "sop_level_id": "low_efficiency_p2",
          "level_label": "P2",
          "normalized_severity": "medium",
          "priority_order": 3,
          "sla_minutes": 240,
          "sla_text": "4小时内响应",

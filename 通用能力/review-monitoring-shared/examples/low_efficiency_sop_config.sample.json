        {
          "sop_id": "low_efficiency_labeling",
          "sop_level_id": "low_efficiency_notice",
          "level_label": "notice",
          "normalized_severity": "low",
          "priority_order": 4,
          "sla_minutes": 1440,
          "sla_text": "当天同步，纳入周报观察",
          "requires_human_confirm": false,
          "default_audience_policy": "人审运营",
          "enabled": true
        }
      ],
      "rule_groups": [
        {
          "rule_group_id": "rule_low_label_rate_p2",
          "sop_level_id": "low_efficiency_p2",
          "condition_logic": "labeling_rate < 0.1 AND avg_review_in >= 100",
          "window_policy": "last_7_complete_days",
          "metric_refs": ["metric_low_label_rate_reason"],
          "rule_key": "rule_low_label_rate_p2",
          "route_grain": "reason",
          "audience_policy": "治理 BP、人审运营",
          "enabled": true
        }
      ],
      "report_policies": [
        {
          "report_policy_id": "low_efficiency_grading_report_only",
          "report_type": "low_efficiency_grading",
          "template_name": "low_efficiency_grading_report",
          "sheet_policy": {
            "strategy": "reuse_or_import",
            "sheet_name_template": "{sop_name}-{period}-{report_type}"
          },
          "report_target_policy": {
            "target_type": "runtime_override",
            "target_ref": null,
            "auto_send": false
          },
          "sender_identity": "bot",
          "render_options": {"top_n": 10},
          "idempotency_policy": {
            "parts": ["sop_id", "report_type", "run_id"],
            "max_length": 50
          },
          "enabled": true
        },
        {
          "report_policy_id": "low_efficiency_p2_detail_report_only",
          "report_type": "low_efficiency_level_detail",
          "template_name": "low_efficiency_level_detail",
          "level_selector": "P2",
          "sheet_policy": {
            "strategy": "reuse_or_import",
            "sheet_name_template": "{sop_name}-{period}-{report_type}-P2"
          },
          "report_target_policy": {
            "target_type": "runtime_override",
            "target_ref": null,
            "auto_send": false
          },
          "sender_identity": "bot",
          "render_options": {"top_n": 10},
          "idempotency_policy": {
            "parts": ["sop_id", "report_type", "level", "run_id"],
            "max_length": 50
          },
          "enabled": true
        }
      ],
      "route_policies": [
        {
          "route_policy_id": "low_efficiency_reason_route",
          "route_grain": "reason",
          "route_key_fields": ["reason"],
          "owner_source_id": "reason_owner_mapping",
          "fallback_policy": "missing_owner_only",
          "enabled": true

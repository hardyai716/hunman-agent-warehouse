          "default_chat_id": "oc_reason_a",
          "default_chat_name": "低效策略-reason-A",
          "enabled": true,
          "priority": 10
        },
        {
          "route_key": "political_figure_risk_review",
          "route_key_alias": "领导人风险审核",
          "owner_role": "业务 POC",
          "owner_user": {"id": "ou_owner_b", "name": "负责人B"},
          "collaborators": [{"id": "ou_ops_a", "name": "人审运营A"}],
          "escalation_users": [{"id": "ou_manager_b", "name": "治理负责人B"}],
          "default_chat_id": "oc_reason_b",
          "default_chat_name": "低效策略-reason-B",
          "enabled": true,
          "priority": 20
        }
      ]
    }
  ],
  "sops": [
    {
      "sop_id": "low_efficiency_labeling",

{
  "schema_version": "sop_config.v1",
  "process_skill_registry": [
    {
      "process_skill": "low-efficiency-strategy-analysis",
      "business_domain": "efficiency",
      "supported_sop_types": ["low_efficiency_labeling"],
      "supported_report_types": [
        "low_efficiency_dimension_breakdown",
        "low_efficiency_grading",
        "low_efficiency_level_detail"
      ],
      "required_domain_reference": "efficiency_domain",
      "required_siblings": ["warehouse-skill"],
      "runtime_tool_dependencies": ["bytedance-aeolus", "lark-sheets", "lark-im"],
      "validation_command": "python3 scripts/test_sql_templates.py",
      "input_contract": {
        "required_fields": ["period_start", "period_end", "data_source_id", "rule_group_id"]
      },
      "output_contract": {
        "schema_version": "process_output.v1",
        "route_grains": ["reason", "strategy"],
        "level_field": "_level",
        "required_files_by_report_type": {
          "low_efficiency_grading": ["summary.json", "综合.csv"],
          "low_efficiency_level_detail": ["summary.json", "{level}.csv"],
          "low_efficiency_dimension_breakdown": [
            "summary.json",
            "sheet1_mach_label_reason_detail.csv",
            "sheet2_mach_label_summary.csv"
          ]
        }
      }
    }
  ],
  "report_template_registry": [
    {
      "report_type": "low_efficiency_grading",
      "template_name": "low_efficiency_grading_report",
      "scene": "report_card",
      "local_template_name": "low_efficiency_grading_report.card_template.json",
      "required_artifacts": ["summary.json", "综合.csv"],
      "required_variables": ["sop_name", "period", "summary_metrics", "top_items", "sheet_url"],
      "enabled": true
    },
    {
      "report_type": "low_efficiency_level_detail",
      "template_name": "low_efficiency_level_detail",
      "scene": "report_card",
      "local_template_name": "low_efficiency_level_detail.card_template.json",
      "required_artifacts": ["summary.json", "{level}.csv"],
      "required_variables": ["sop_name", "period", "level_label", "top_items", "sheet_url"],
      "enabled": true
    },
    {
      "report_type": "low_efficiency_dimension_breakdown",
      "template_name": "low_efficiency_dimension_report",
      "scene": "report_card",
      "local_template_name": "low_efficiency_dimension_report.card_template.json",
      "required_artifacts": [
        "summary.json",
        "sheet1_mach_label_reason_detail.csv",
        "sheet2_mach_label_summary.csv"
      ],
      "required_variables": ["sop_name", "period", "summary_metrics", "top_items", "sheet_url"],
      "enabled": true
    }
  ],
